CREATE DATABASE HEALTHCARE;
USE HEALTHCARE;
-- SECTION A - PATIENT FLOW AND WAITING TIMES
-- Q1. Where do patients wait the longest? Average wait per stage and triage level.
SELECT
    f.Event_Type AS stage,
    e.Triage_Level,
    COUNT(*) AS events,
    ROUND(AVG(f.Waiting_Time_Minutes), 1) AS avg_wait_min,
    MAX(f.Waiting_Time_Minutes) AS max_wait_min

FROM patient_flow_events_clean AS f
INNER JOIN encounters_clean AS e
    ON e.Encounter_ID = f.Encounter_ID
WHERE
    f.Waiting_Time_Minutes IS NOT NULL
    AND f.Event_Status <> 'Cancelled'
    AND f.Event_Type <> 'Unknown'
    AND e.Triage_Level <> 'Unknown'
GROUP BY
    f.Event_Type,
    e.Triage_Level
ORDER BY
    f.Event_Type,
    avg_wait_min DESC;
    
    -- Q2. Which stage of the journey is the bottleneck? Share of delayed events per stage.
    SELECT Event_Type AS stage,
       COUNT(*) AS events,
       SUM(CASE WHEN Event_Status = 'Delayed' THEN 1 ELSE 0 END) AS delayed_events,
       ROUND(100.0 * SUM(CASE WHEN Event_Status = 'Delayed' THEN 1 ELSE 0 END) / COUNT(*), 1) AS delayed_pct,
       ROUND(AVG(Waiting_Time_Minutes), 1) AS avg_wait_min
FROM patient_flow_events_clean
WHERE Event_Status IN ('Completed', 'Delayed') AND Event_Type <> 'Unknown'
GROUP BY Event_Type
ORDER BY delayed_pct DESC;

-- Q3. Safety check: how many Critical patients waited more than 10 minutes for a doctor?
SELECT COUNT(*) AS critical_patients,
       SUM(CASE WHEN f.Waiting_Time_Minutes > 10 THEN 1 ELSE 0 END) AS waited_over_10_min,
       ROUND(100.0 * SUM(CASE WHEN f.Waiting_Time_Minutes > 10 THEN 1 ELSE 0 END) / COUNT(*), 1) AS pct_over_10_min,
       MAX(f.Waiting_Time_Minutes) AS longest_wait_min
FROM patient_flow_events_clean f
JOIN encounters_clean e ON e.Encounter_ID = f.Encounter_ID
WHERE f.Event_Type = 'Doctor' AND e.Triage_Level = 'Critical' AND f.Waiting_Time_Minutes IS NOT NULL;

-- Q4. How long from walking into the ER until a doctor starts seeing the patient (door-to-doctor)?
USE healthcare;
SELECT
    e.Triage_Level,
    COUNT(DISTINCT e.Encounter_ID) AS patients,

    ROUND(
        AVG(
            TIMESTAMPDIFF(
                SECOND,
                e.Admission_DateTime,
                d.Event_Start_Time
            ) / 60.0 + d.Waiting_Time_Minutes
        ),
        1
    ) AS door_to_doctor_min

FROM encounters_clean AS e

INNER JOIN patient_flow_events_clean AS d
    ON d.Encounter_ID = e.Encounter_ID
    AND d.Event_Type = 'Doctor'

WHERE
    e.Department_ID = 'D01'
    AND d.Waiting_Time_Minutes IS NOT NULL
    AND e.Triage_Level <> 'Unknown'
    AND e.Admission_DateTime IS NOT NULL
    AND d.Event_Start_Time IS NOT NULL

GROUP BY
    e.Triage_Level

ORDER BY
    door_to_doctor_min DESC;
    
